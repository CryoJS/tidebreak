    <Variable Type="string" Name="Controls.HeaderText" SetsValue="true">
      <Value xsi:type="xsd:string">Controls</Value>
    </Variable>
    <Variable Type="float" Name="Controls.Height" SetsValue="true">
      <Value xsi:type="xsd:float">847</Value>
    </Variable>
    <Variable Type="string" Name="Controls.Parent" SetsValue="true">
